<Window x:Class="GameplayTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:GameplayTimeTracker"
        mc:Ignorable="d"
        Title="Gameplay Time Tracker"
        Height="800"
        Width="870"
        MinWidth="870"
        Icon="pack://application:,,,/Assets/GameplayTimeTracker.ico">

    <Window.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Open" Click="TrayMenu_Open_Click" />
            <MenuItem Header="Exit" Click="TrayMenu_Exit_Click" />
        </ContextMenu>

        <StackPanel x:Key="TrayStatusPopup" Background="White" Width="200" Height="100">
            <TextBlock Text="Gameplay Time Tracker is running..."
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Border x:Key="TrayToolTipBorder" CornerRadius="5" BorderThickness="2">
            <Grid x:Name="TrayToolTipGrid" Width="250" Height="100">
                <Image x:Name="IconImage"
                       Source="pack://application:,,,/Assets/GameplayTimeTracker.ico"
                       Width="60" Height="60" HorizontalAlignment="Left"
                       Margin="10,10,0,0">
                    <Image.Effect>
                        <DropShadowEffect Color="Black"
                                          ShadowDepth="5"
                                          BlurRadius="10" />
                    </Image.Effect>
                    <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                </Image>

                <TextBlock x:Name="AppTitleBlock"
                           HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Run x:Name="TitleRun" Text="Gameplay Time Tracker" FontWeight="Bold" FontSize="13" />
                    <Run x:Name="VersionRun" Text="v2.0.0" FontWeight="Regular" FontSize="11" />
                </TextBlock>
            </Grid>
        </Border>

        <tb:TaskbarIcon x:Key="AppTaskbarIcon"
                        ToolTipText="Fallback ToolTip for Windows XP"
                        IconSource="pack://application:,,,/Assets/GameplayTimeTracker.ico"
                        ContextMenu="{StaticResource TrayMenu}"
                        MenuActivation="LeftOrRightClick"
                        TrayPopup="{StaticResource TrayStatusPopup}"
                        PopupActivation="DoubleClick"
                        TrayToolTip="{StaticResource TrayToolTipBorder}" />
    </Window.Resources>

    <Grid x:Name="Root"
          AllowDrop="True"
          DragEnter="Grid_DragEnter"
          DragLeave="Grid_DragLeave"
          Drop="Grid_Drop">

        <Grid x:Name="DragDropGrid" Panel.ZIndex="97" Visibility="Collapsed">
        </Grid>
        <Grid x:Name="MainGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid.RenderTransform>
                <ScaleTransform x:Name="ScaleTransform" />
            </Grid.RenderTransform>


            <!-- <Grid Grid.Row="0" x:Name="Grid0"></Grid> -->

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="MainScrollViewer_ScrollChanged">
                <Border Padding="5">
                    <WrapPanel x:Name="MainPanel"
                               Orientation="Horizontal"
                               HorizontalAlignment="Center" />
                </Border>
            </ScrollViewer>

            <Rectangle x:Name="OverlayTop" Width="870" Height="60" VerticalAlignment="Top" Fill="Aqua" />
            <Rectangle x:Name="OverlayBottom" Width="870" Height="60" VerticalAlignment="Bottom" Fill="Aqua" />

            <Grid Grid.Row="1" x:Name="Footer">
                <TextBlock x:Name="GamesLoadedBlock"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,-2,0,0"
                           FontSize="16">
                    <Run Text="Apps managed" FontWeight="Bold" />
                    <LineBreak />
                    <Run x:Name="GameCountRun" Text="0" FontWeight="Normal" />
                </TextBlock>

                <TextBlock x:Name="TotalPlaytimeTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Margin="0,-2,15,0"
                           FontSize="16">
                    <Run Text="Total Playtime" FontWeight="Bold" />
                    <LineBreak />
                    <Run x:Name="TotalTimeRun" Text="0" FontWeight="Normal" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>