<UserControl x:Class="GameplayTimeTracker.Views.GameItems.GameRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameplayTimeTracker.Views.GameItems"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="700">
    <Border Padding="10"
            Margin="6"
            CornerRadius="6"
            BorderBrush="#333"
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding ExePath}"
                           FontSize="11"
                           Foreground="Gray" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding PlayTimeText}"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="14" />
        </Grid>
    </Border>
</UserControl>
