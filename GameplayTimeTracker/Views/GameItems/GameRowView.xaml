<UserControl x:Class="GameplayTimeTracker.Views.GameItems.GameRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameplayTimeTracker.Views.GameItems"
             xmlns:converters="clr-namespace:GameplayTimeTracker.Converters"
             xmlns:viewModels="clr-namespace:GameplayTimeTracker.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=viewModels:GameViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:TimeSpanPrettyConverter x:Key="TimeSpanPrettyConverter" />
    </UserControl.Resources>

    <Border Padding="10"
            Margin="6"
            CornerRadius="6"
            BorderBrush="#333"
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding ExePath}"
                           FontSize="11"
                           Foreground="Gray"
                           d:Text="This is an exe path" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock
                    Text="{Binding TotalPlaytimeDur, Converter={StaticResource TimeSpanPrettyConverter}, TargetNullValue='0h 00m 00s'}" />
                <TextBlock
                    Text="{Binding LastPlaytimeDur, Converter={StaticResource TimeSpanPrettyConverter}, TargetNullValue='0h 00m 00s'}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>